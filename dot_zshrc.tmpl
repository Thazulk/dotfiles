# ~/.zshrc - macOS. Aliases, editor, PATH and Go setup shared with bash live in
# ~/.config/shell/common.sh; this file keeps only what is zsh-specific.

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

setopt HIST_IGNORE_SPACE  # Don't save when prefixed with space
setopt HIST_IGNORE_DUPS   # Don't save duplicate lines
setopt SHARE_HISTORY      # Share history between sessions

# zsh pure promt
fpath+=($HOME/.zsh/pure)
autoload -U promptinit; promptinit
prompt pure

# Completion definitions must be added to fpath before compinit.
if command -v brew >/dev/null 2>&1; then
  _brew_prefix="$(brew --prefix)"
  fpath=("$_brew_prefix/share/zsh/site-functions" $fpath)
  if [[ -d "$_brew_prefix/share/zsh-completions" ]]; then
    fpath=("$_brew_prefix/share/zsh-completions" $fpath)
  fi
  unset _brew_prefix
fi

if [[ -d "$HOME/zsh-completions/src" ]]; then
  fpath=("$HOME/zsh-completions/src" $fpath)
fi

autoload -Uz compinit
compinit

source "$HOME/.config/shell/common.sh"

alias reload='source ~/.zshrc'
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
# Enable vi mode
bindkey -v

fzf-cd-widget() {
  local selected
  selected="$("$HOME/.local/scripts/fzf-dir")" || return
  [[ -n "$selected" ]] && cd -- "$selected"
  zle reset-prompt
}
zle -N fzf-cd-widget
# change directory with ctrl+f
bindkey -M viins ^f fzf-cd-widget
# open herdr sessionizer with ctrl+h
bindkey -M viins -s ^h "herdr-sessionizer\n"
# open vscode with alt+f
bindkey -M viins -s "^[f" "vscode-sessionizer\n"

if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion zsh)
  compdef __start_kubectl k
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Keep the native completion menu out of the way and expose descriptions as
# groups in fzf-tab.
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' menu no

# fzf-tab must be the last plugin that binds Tab.
{{ if eq .chezmoi.os "linux" -}}
if [[ -r /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh ]]; then
  source /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
fi
{{- else -}}
if command -v brew >/dev/null 2>&1; then
  _fzf_tab_root="$(brew --prefix fzf-tab 2>/dev/null)"
  if [[ -r "$_fzf_tab_root/share/fzf-tab/fzf-tab.zsh" ]]; then
    source "$_fzf_tab_root/share/fzf-tab/fzf-tab.zsh"
  fi
  unset _fzf_tab_root
fi
{{- end }}
