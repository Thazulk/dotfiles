{{ if ne .chezmoi.os "darwin" }}
Library/**
# zsh is the macOS shell; Linux and WSL use bash with the same
# ~/.config/shell/common.sh, and no script requires zsh.
.zshrc
.zprofile
.zsh
.zsh/**
{{ end }}

{{ if ne .chezmoi.os "windows" }}
Documents/**
.config/powershell/**
{{ end }}

{{ if stat "/usr/share/omarchy" }}
# Omarchy owns the desktop session, terminal theme and git identity. Its
# defaults win on conflict; dotfiles only add what Omarchy does not cover.
.config/hypr
.config/hypr/**
.config/waybar
.config/waybar/**
.config/mako
.config/mako/**
.config/ghostty
.config/ghostty/**
.config/environment.d
.config/environment.d/**
.config/git/config
{{ else }}
# Only needed on Omarchy, where ~/.config/git/config belongs to Omarchy.
.gitconfig
{{ end }}

README.md
LICENSE
setup
tests/**

**/__pycache__/**
