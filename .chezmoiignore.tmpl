{{ if ne .chezmoi.os "darwin" }}
Library/**
# zsh is the macOS shell; Linux and WSL use bash with the same
# ~/.config/shell/common.sh, and no script requires zsh.
.zshrc
.zprofile
.zsh
.zsh/**
{{ end }}

{{ if ne .chezmoi.os "windows" }}
Documents/**
.config/powershell/**
{{ end }}

{{ if stat "/usr/share/omarchy" }}
# Omarchy owns the desktop session and git identity. Only the Omarchy files
# customized here are tracked; its defaults win everywhere else.
.config/environment.d
.config/environment.d/**
.config/git/config
{{ if not (stat (joinPath .chezmoi.sourceDir ".chezmoitemplates/monitors" (printf "%s.lua" .chezmoi.hostname))) }}
# No monitor layout recorded for this host; leave Omarchy's generated one.
.config/hypr/monitors.lua
{{ end }}
{{ else }}
# Omarchy settings apply only on Omarchy.
.config/hypr
.config/hypr/**
.config/omarchy
.config/omarchy/**
# Only needed on Omarchy, where ~/.config/git/config belongs to Omarchy.
.gitconfig
{{ end }}

README.md
LICENSE
setup
tests/**

**/__pycache__/**
