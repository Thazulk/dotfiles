#!/bin/bash
# chezmoi:template
# settings-sha256: {{ include ".chezmoitemplates/cursor-settings.json" | sha256sum }}
# keybindings-sha256: {{ include ".chezmoitemplates/cursor-keybindings.json" | sha256sum }}
set -euo pipefail

is_wsl() {
    [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null
}

windows_appdata_roaming() {
    # Optional override via chezmoi data (see chezmoi.toml)
    {{ with index . "windowsAppDataRoaming" -}}
    {{ if . -}}
    echo "{{ . }}"
    return 0
    {{ end -}}
    {{ end -}}

    local win_path
    win_path=$(powershell.exe -NoProfile -Command '[Environment]::GetFolderPath("ApplicationData")' 2>/dev/null | tr -d '\r\n')
    if [[ -n "$win_path" ]] && command -v wslpath >/dev/null 2>&1; then
        wslpath -u "$win_path"
        return 0
    fi

    local win_user
    win_user=$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r\n')
    if [[ -n "$win_user" && -d "/mnt/c/Users/${win_user}/AppData/Roaming" ]]; then
        echo "/mnt/c/Users/${win_user}/AppData/Roaming"
        return 0
    fi

    return 1
}

if ! is_wsl; then
    exit 0
fi

linux_user_dir="$HOME/.config/Cursor/User"
win_user_dir="$(windows_appdata_roaming)/Cursor/User"

if [[ ! -d "$linux_user_dir" ]]; then
    echo "WSL: Linux Cursor User dir not found: $linux_user_dir" >&2
    exit 1
fi

if ! win_roaming="$(windows_appdata_roaming)"; then
    echo "WSL: Could not resolve Windows AppData path. Set windowsAppDataRoaming in chezmoi.toml" >&2
    exit 1
fi
win_user_dir="${win_roaming}/Cursor/User"

mkdir -p "$win_user_dir"

for file in settings.json keybindings.json; do
    if [[ -f "$linux_user_dir/$file" ]]; then
        cp "$linux_user_dir/$file" "$win_user_dir/$file"
        echo "WSL: synced $file → $win_user_dir/$file"
    fi
done

if [[ -d "$linux_user_dir/snippets" ]]; then
    mkdir -p "$win_user_dir/snippets"
    cp -r "$linux_user_dir/snippets/." "$win_user_dir/snippets/"
    echo "WSL: synced snippets → $win_user_dir/snippets/"
fi
