#!/usr/bin/env zsh
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: agent-ask-gemini <prompt | prompt-file>" >&2
  exit 2
fi

if [[ $# -eq 1 && -f "$1" ]]; then
  prompt="$(cat "$1")"
else
  prompt="$*"
fi

model="${GEMINI_MODEL:-gemini-3.8-flash}"

load_env_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "" || "$line" == \#* || "$line" != *=* ]] && continue
    local key="${line%%=*}"
    local value="${line#*=}"
    [[ "$key" == "GEMINI_API_KEY" || "$key" == "GOOGLE_API_KEY" || "$key" == "GEMINI_MODEL" ]] || continue
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    export "$key=$value"
  done < "$file"
}

load_env_file "$HOME/.gemini/.env"
load_env_file "$HOME/.env"

if [[ -z "${GEMINI_API_KEY:-}" && "$(command -v security 2>/dev/null)" != "" ]]; then
  keychain_account="${GEMINI_KEYCHAIN_ACCOUNT:-$USER}"
  keychain_service="${GEMINI_KEYCHAIN_SERVICE:-agent-gemini-api-key}"
  if key="$(security find-generic-password -a "$keychain_account" -s "$keychain_service" -w 2>/dev/null)"; then
    export GEMINI_API_KEY="$key"
  fi
fi

if [[ -z "${GEMINI_API_KEY:-}" && "${GEMINI_ALLOW_PLAINTEXT_KEY_FILE:-0}" == "1" && -s "$HOME/gemini.txt" ]]; then
  key="$(tr -d '\r\n' < "$HOME/gemini.txt")"
  if [[ "$key" == GEMINI_API_KEY=* ]]; then
    key="${key#GEMINI_API_KEY=}"
  fi
  key="${key%\"}"
  key="${key#\"}"
  key="${key%\'}"
  key="${key#\'}"
  export GEMINI_API_KEY="$key"
fi

if [[ -z "${GEMINI_API_KEY:-}" ]]; then
  cat >&2 <<'MSG'

Gemini headless call failed: GEMINI_API_KEY is not visible to this process.
Set GEMINI_API_KEY in the environment, or store it in macOS Keychain using GEMINI_KEYCHAIN_SERVICE.
MSG
  exit 1
fi

if [[ "${GEMINI_TRANSPORT:-api}" == "api" ]]; then
  GEMINI_PROMPT="$prompt" GEMINI_MODEL="$model" node <<'NODE'
const key = process.env.GEMINI_API_KEY;
const prompt = process.env.GEMINI_PROMPT || '';
const fs = require('fs');
const os = require('os');
const path = require('path');
// ponytail: fixed 4-try backoff + one cheaper fallback model. 503/429 here is
// Google-side overload ("high demand"), not our bug. Bump tries if it still bites.
const models = [process.env.GEMINI_MODEL || 'gemini-3.8-flash', 'gemini-3.7-flash'];
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

function logUsage(model, usage) {
  if (!usage) return;
  try {
    fs.appendFileSync(path.join(os.homedir(), '.gemini', 'codex-api-usage.jsonl'), JSON.stringify({
      ts: new Date().toISOString(),
      model,
      input: usage.promptTokenCount || 0,
      output: usage.candidatesTokenCount || 0,
      cached: usage.cachedContentTokenCount || 0,
      thoughts: usage.thoughtsTokenCount || 0,
      tool: 0,
      total: usage.totalTokenCount || 0,
    }) + '\n');
  } catch (_) {}
}

async function ask(model) {
  for (let attempt = 0; attempt < 4; attempt++) {
    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'x-goog-api-key': key},
      body: JSON.stringify({contents: [{parts: [{text: prompt}]}]}),
    });
    const payload = await response.json();
    if (response.ok) return payload;
    const msg = payload.error?.message || JSON.stringify(payload);
    const retryable = response.status === 429 || response.status >= 500;
    if (!retryable || attempt === 3) throw new Error(`${model}: ${msg}`);
    const wait = 2000 * 2 ** attempt;
    console.error(`${model} unavailable (${response.status}), retrying in ${wait / 1000}s: ${msg}`);
    await sleep(wait);
  }
}

(async () => {
  const errors = [];
  for (const model of models) {
    try {
      const payload = await ask(model);
      logUsage(model, payload.usageMetadata);
      const text = payload.candidates?.[0]?.content?.parts?.map((part) => part.text || '').join('');
      if (text) console.log(text.trim());
      return;
    } catch (error) {
      errors.push(error.message);
      console.error(`falling back from ${model}`);
    }
  }
  console.error(errors.join('\n'));
  process.exit(1);
})();
NODE
  exit $?
fi

tmp="$(mktemp)"
if gemini --approval-mode plan -m "$model" -p "$prompt" 2>"$tmp"; then
  rm -f "$tmp"
  exit 0
fi

err="$(cat "$tmp")"
rm -f "$tmp"
printf '%s\n' "$err" >&2

if [[ "$err" == *"must specify the GEMINI_API_KEY"* ]]; then
  cat >&2 <<'MSG'

Gemini headless call failed: GEMINI_API_KEY is not visible to this process.
Set GEMINI_API_KEY in the environment, or store it in macOS Keychain using GEMINI_KEYCHAIN_SERVICE.
MSG
elif [[ "$err" == *"cloudcode-pa.googleapis.com"* || "$err" == *"Cloud Code Private API"* ]]; then
  cat >&2 <<'MSG'

Gemini headless call failed: Cloud Code Private API is blocked for the configured Google project.
Use Gemini API key auth or ask a project admin to enable cloudcode-pa.googleapis.com.
MSG
else
  cat >&2 <<'MSG'

Gemini headless call failed with an unclassified error.
MSG
fi
exit 1
