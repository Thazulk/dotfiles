#!/usr/bin/env bash
# Refresh agent plugin/tooling surfaces without changing project worktrees.
set -uo pipefail
failed=0

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

say() { printf '%s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

run() {
    say "+ $*"
    if "$@"; then
        return 0
    fi
    say "WARNING: failed: $*" >&2
    failed=1
    return 1
}

codex_plugin_installed() {
    grep -q "\\[plugins\\.\"$1\"\\]" "$HOME/.codex/config.toml" 2>/dev/null
}


if have mise; then
    eval "$(mise env --shell bash)"
fi

say "==> AI toolstack update"

if have codex; then
    run codex plugin marketplace upgrade --json
    # The curated marketplace name depends on the Codex login state.
    superpowers="$(codex plugin list 2>/dev/null | grep -oE '^superpowers@[A-Za-z0-9._-]+' | head -n1)"
    if [[ -n "$superpowers" ]]; then
        codex_plugin_installed "$superpowers" || run codex plugin add "$superpowers"
    fi
    codex_plugin_installed ponytail@ponytail || run codex plugin add ponytail@ponytail
else
    say "skip: codex is not installed"
fi

if have claude; then
    run claude plugin marketplace update
    # Refresh every user-scoped installation, including disabled plugins, without enabling it.
    plugins="$(claude plugin list --json)" || { failed=1; plugins='[]'; }
    plugin_ids="$(printf '%s' "$plugins" | python3 -c 'import json,sys; print("\n".join(p["id"] for p in json.load(sys.stdin) if p.get("scope") == "user"))')" || failed=1
    while IFS= read -r plugin; do
        [[ -n "$plugin" ]] || continue
        run claude plugin update "$plugin" --scope user --json || true
    done <<< "$plugin_ids"

else
    say "skip: claude is not installed"
fi

# Install declared versions; pinned tools are advanced deliberately in the manifest.
if [[ "${TOOLSTACK_SKIP_MISE:-0}" != "1" ]] && have mise; then
    run mise install || true
fi
if have bootstrap-ai-toolstack; then
    run env TOOLSTACK_SKIP_MISE=1 bootstrap-ai-toolstack || true
fi

say "==> Done (failures: $failed)."
exit "$failed"
