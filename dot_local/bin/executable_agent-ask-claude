#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: agent-ask-claude <prompt | prompt-file>" >&2
  exit 2
fi

if [[ $# -eq 1 && -f "$1" ]]; then
  prompt="$(cat "$1")"
else
  prompt="$*"
fi

# Subscription quota is the ceiling; API-equivalent budget is opt-in.
if [[ -n "${CLAUDE_MAX_BUDGET_USD:-}" ]]; then
  exec claude -p --permission-mode plan --max-budget-usd "$CLAUDE_MAX_BUDGET_USD" "$prompt" </dev/null
fi
exec claude -p --permission-mode plan "$prompt" </dev/null
