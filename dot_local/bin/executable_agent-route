#!/usr/bin/env python3
"""Pick the agent+model for a task class, cheapest-money-first.

Usage:  agent-route <cheap|code|review|hard|long|orchestrate> [--agent codex|claude]
Set AGENT_ROUTING_AGENT when the app does not expose its session environment.
Matrix: ~/.claude/MODEL-MATRIX.md

Cost tiers:
  quota -- subscription already paid for; marginal cost zero until exhausted
  money -- Codex top-up: real per-token spend, so Codex demotes below quota
           choices. `hard` and `orchestrate` intentionally keep Astra because a
           weak model on hard work costs more in retries than the cheaper tier saved.
"""
import subprocess, sys, os, time, argparse

PROBE_TTL = 900
PROBE_CACHE = os.path.expanduser("~/.cache/agent-route/codex-probe")

NORMAL_CODEX = "gpt-6.1-sol"          # everyday Codex default; gpt-5.6-* remains banned
PREMIUM_CODEX = "gpt-6-astra"     # expensive; use for high-value implementation/review/orchestration

# label, command template, agent, cost tier, codex model hint
CHAIN = {
    "cheap": [
        ("Claude Haiku 4.5",      None,                                                                           "claude", "quota", None),
        ("Gemini 3.8 Flash", 'GEMINI_MODEL=gemini-3.8-flash agent-ask-gemini {q}', "gemini", "quota", None),
        ("Codex",                 'codex exec -m {m} --sandbox read-only {q}',                                    "codex",  "money", NORMAL_CODEX),
    ],
    "code": [
        ("Codex",           'codex exec -m {m} --sandbox workspace-write {q}', "codex",  "money", NORMAL_CODEX),
        ("Codex Astra",     'codex exec -m {m} --sandbox workspace-write {q}', "codex",  "money", PREMIUM_CODEX),
        ("Claude Sonnet 5", None,                                             "claude", "quota", None),
        ("Gemini 3.8 Flash", 'GEMINI_MODEL=gemini-3.8-flash agent-ask-gemini {q}', "gemini", "quota", None),
    ],
    "review": [
        ("Codex", 'codex exec -m {m} --sandbox read-only {q}', "codex", "money", NORMAL_CODEX),
        ("Codex Astra", 'codex exec -m {m} --sandbox read-only {q}', "codex", "money", PREMIUM_CODEX),
        ("Claude Opus 5", None, "claude", "quota", None),
    ],
    "hard": [
        ("Codex Astra",   'codex exec -m {m} --sandbox workspace-write {q}', "codex",  "money", PREMIUM_CODEX),
        ("Claude Opus 5", None,                                             "claude", "quota", None),
        ("Codex",         'codex exec -m {m} --sandbox workspace-write {q}', "codex",  "money", NORMAL_CODEX),
        ("Claude Fable 5", None,                                            "claude", "quota", None),
    ],
    "long": [
        ("Codex", 'codex exec -m {m} --sandbox workspace-write {q}', "codex", "money", NORMAL_CODEX),
        ("Claude Sonnet 5", None, "claude", "quota", None),
        ("Claude Opus 5",   None, "claude", "quota", None),
        ("Gemini 3.8 Flash", 'GEMINI_MODEL=gemini-3.8-flash agent-ask-gemini {q}', "gemini", "quota", None),
    ],
    "orchestrate": [
        ("Codex Astra",   'codex exec -m {m} --sandbox workspace-write {q}', "codex",  "money", PREMIUM_CODEX),
        ("Codex",         'codex exec -m {m} --sandbox workspace-write {q}', "codex",  "money", NORMAL_CODEX),
        ("Claude Opus 5", None,                                             "claude", "quota", None),
        ("Claude Sonnet 5", None,                                           "claude", "quota", None),
    ],
}


def exhausted():
    try:
        out = subprocess.run(["agent-quota"], capture_output=True, text=True, timeout=30).stdout
    except Exception:
        return set()
    return {l.split(":")[0].strip() for l in out.splitlines() if "EXHAUSTED" in l}


def codex_live():
    """Cheapest possible liveness probe; cached so routing stays ~free."""
    try:
        if time.time() - os.stat(PROBE_CACHE).st_mtime < PROBE_TTL:
            return open(PROBE_CACHE).read().strip() == "live"
    except OSError:
        pass
    try:
        r = subprocess.run(
            ["codex", "exec", "-m", "gpt-6.1-sol", "--sandbox", "read-only",
             "--skip-git-repo-check", "ok"],
            capture_output=True, text=True, timeout=90, stdin=subprocess.DEVNULL)
        live = r.returncode == 0
    except Exception:
        live = False
    os.makedirs(os.path.dirname(PROBE_CACHE), exist_ok=True)
    open(PROBE_CACHE, "w").write("live" if live else "dead")
    return live


def gemini_available():
    """agent-ask-gemini needs an API key from env, ~/.gemini/.env, ~/.env or Keychain."""
    if os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY"):
        return True
    for env_file in ("~/.gemini/.env", "~/.env"):
        try:
            text = open(os.path.expanduser(env_file)).read()
        except OSError:
            continue
        if any(line.startswith(("GEMINI_API_KEY=", "GOOGLE_API_KEY=")) for line in text.splitlines()):
            return True
    try:
        service = os.environ.get("GEMINI_KEYCHAIN_SERVICE", "agent-gemini-api-key")
        return subprocess.run(["security", "find-generic-password", "-s", service],
                              capture_output=True, timeout=10).returncode == 0
    except Exception:
        return False


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in CHAIN:
        print(__doc__.strip() + "\n\nclasses: " + ", ".join(CHAIN))
        sys.exit(1)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("task", choices=CHAIN)
    parser.add_argument("--agent", choices=("codex", "claude"))
    args = parser.parse_args()
    current = args.agent or os.environ.get("AGENT_ROUTING_AGENT")
    if not current:
        current = "claude" if os.environ.get("CLAUDECODE") else "codex" if os.environ.get("CODEX_THREAD_ID") else None
    if current not in (None, "codex", "claude"):
        parser.error("AGENT_ROUTING_AGENT must be codex or claude")
    cls, dead = args.task, exhausted()
    entries, notes = [], []

    chain = list(CHAIN[cls])
    if current:
        chain.sort(key=lambda row: row[2] != current)
    for label, cmd, agent, cost, model_hint in chain:
        if agent == "claude":
            cmd = 'agent-ask-claude {q}'
        if agent == current:
            cmd = 'stay in this session (its own model)'
        if agent == "gemini" and not gemini_available():
            notes.append(f"  skip  {label}  [gemini API key not configured]")
            continue
        if agent in dead:
            if agent != "codex":
                notes.append(f"  skip  {label}  [{agent} quota exhausted]")
                continue
            if not codex_live():
                notes.append(f"  skip  {label}  [codex exhausted, probe failed]")
                continue
            # quota gone -> top-up is real money: keep the class model, but demote below quota.
            model = model_hint or NORMAL_CODEX
            label = f"{label} {model}  [TOP-UP $ -- quota spent]"
            cost = "money"
        else:
            model = model_hint if agent == "codex" else None
            if agent == "codex":
                label = f"{label} {model}"
                cost = "quota"        # inside quota it is subscription-paid, not top-up
        entries.append((0 if cost != "money" else 1, label, cmd, model, cost))

    entries.sort(key=lambda e: e[0])          # stable: money last
    print(f"class: {cls}   exhausted: {', '.join(sorted(dead)) or 'none'}")
    print("-" * 62)
    for i, (_, label, cmd, model, cost) in enumerate(entries):
        tag = {"quota": "paid-for", "money": "COSTS $"}[cost]
        line = (cmd or "stay in this session (its own model)")
        if model:
            line = line.replace("{m}", model)
        line = line.replace("{q}", '"<prompt>"')
        if i == 0:
            print(f"> USE  {label}   ({tag})\n        {line}")
        else:
            print(f"  next: {label}   ({tag})")
    for n in notes:
        print(n)
    if not entries:
        print("  no available route")


if __name__ == "__main__":
    main()
