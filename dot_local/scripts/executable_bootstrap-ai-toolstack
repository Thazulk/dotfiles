#!/usr/bin/env bash
# Install the portable AI development toolstack on macOS, Linux, or WSL.
# This is deliberately manual: `chezmoi apply` should not download packages
# or rewrite assistant configuration without an explicit user action.
set -u

# uv's default tool directory on macOS/Linux/WSL. This makes tools installed
# earlier in this same run available for the Codex MCP configuration below.
export PATH="$HOME/.local/bin:$PATH"

say() { printf '%s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

run() {
    say "+ $*"
    if "$@"; then
        return 0
    fi
    say "WARNING: failed: $*" >&2
    return 0
}

install_uv_tool() {
    local package="$1" command="$2"
    if have "$command"; then
        say "ok: $command"
    elif have uv; then
        run uv tool install "$package"
    else
        say "skip: $package (uv is not installed)" >&2
    fi
}

codex_mcp_has() {
    codex mcp list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -Fxq "$1"
}

add_codex_mcp() {
    local name="$1"
    shift
    if codex_mcp_has "$name"; then
        say "ok: Codex MCP $name"
    else
        run codex mcp add "$name" -- "$@"
    fi
}

say "==> AI toolstack bootstrap"

if have mise; then
    run mise install
else
    say "skip: mise is not installed; install it first, then rerun this script" >&2
fi

if ! have rtk; then
    if have brew; then
        run brew install rtk
    else
        say "skip: RTK needs a package-manager install on this platform" >&2
    fi
fi

if have npm; then
    run npm install -g --allow-scripts=@suatkocar/codegraph,codebase-memory-mcp \
        @upstash/context7-mcp codebase-memory-mcp @suatkocar/codegraph
else
    say "skip: npm is not installed" >&2
fi

install_uv_tool ddgs ddgs
install_uv_tool 'headroom-ai[all]' headroom

if have repowise; then
    say "ok: repowise"
elif have uv; then
    # Repowise currently needs Python 3.13 rather than the latest Python.
    python313=""
    if have mise; then
        python313="$(mise exec python@3.13 -- which python3 2>/dev/null || true)"
    fi
    if [[ -n "$python313" ]]; then
        run uv tool install --python "$python313" repowise
    else
        say "skip: repowise needs mise Python 3.13; run 'mise install' first" >&2
    fi
else
    say "skip: repowise (uv is not installed)" >&2
fi

if have codex; then
    have context7-mcp && add_codex_mcp context7 "$(command -v context7-mcp)"
    have codebase-memory-mcp && add_codex_mcp codebase-memory "$(command -v codebase-memory-mcp)"
    have codegraph && add_codex_mcp codegraph "$(command -v codegraph)" serve
    have ddgs && add_codex_mcp ddgs "$(command -v ddgs)" mcp
    have repowise && add_codex_mcp repowise "$(command -v repowise)" mcp
else
    say "skip: Codex MCP configuration (codex is not installed)" >&2
fi

if [[ "${TOOLSTACK_ENABLE_RTK:-0}" == "1" ]] && have rtk; then
    run rtk init --global --codex
else
    say "optional: TOOLSTACK_ENABLE_RTK=1 bootstrap-ai-toolstack"
fi

if [[ "${TOOLSTACK_ENABLE_HEADROOM:-0}" == "1" ]] && have headroom; then
    run headroom install apply
else
    say "optional: TOOLSTACK_ENABLE_HEADROOM=1 bootstrap-ai-toolstack"
fi

say "==> Done. Run check-ai-toolstack to inspect the result."
