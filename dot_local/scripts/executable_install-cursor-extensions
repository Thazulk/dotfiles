#!/usr/bin/env bash
# Install Cursor extensions from extensions.txt (manual run; same logic as chezmoi run_onchange).
set -euo pipefail

extensions_file="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/dot_local/share/cursor/extensions.txt"
if [[ ! -f "$extensions_file" ]]; then
    extensions_file="$HOME/.local/share/cursor/extensions.txt"
fi
if [[ ! -f "$extensions_file" ]]; then
    echo "extensions list not found: $extensions_file" >&2
    exit 1
fi

install_extensions() {
    local cmd=("$1")
    echo "==> Installing via ${cmd[*]}"
    while IFS= read -r ext || [[ -n "$ext" ]]; do
        [[ -z "$ext" || "$ext" == \#* ]] && continue
        "${cmd[@]}" --install-extension "$ext" --force 2>/dev/null || true
    done < "$extensions_file"
}

is_wsl() {
    [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null
}

windows_cursor_cli() {
    local win_user candidates c
    win_user=$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r\n')
    candidates=(
        "/mnt/c/Users/${win_user}/AppData/Local/Programs/cursor/resources/app/bin/cursor.cmd"
        "/mnt/c/Users/${win_user}/AppData/Local/Programs/Cursor/resources/app/bin/cursor.cmd"
        "/mnt/c/Program Files/Cursor/resources/app/bin/cursor.cmd"
    )
    for c in "${candidates[@]}"; do
        if [[ -f "$c" ]]; then
            echo "$c"
            return 0
        fi
    done
    command -v cursor.cmd >/dev/null 2>&1 && echo "cursor.cmd" && return 0
    return 1
}

cursor_cli_available() {
    command -v cursor >/dev/null 2>&1 && return 0
    command -v cursor.cmd >/dev/null 2>&1 && return 0
    if is_wsl; then
        windows_cursor_cli >/dev/null 2>&1 && return 0
    fi
    return 1
}

if ! cursor_cli_available; then
    echo "Cursor CLI not found; install Cursor or open a WSL folder in Cursor once" >&2
    exit 1
fi

installed=0
if is_wsl; then
    if cursor_cli=$(windows_cursor_cli); then
        install_extensions "$cursor_cli"
        installed=1
    fi
    if command -v cursor >/dev/null 2>&1; then
        install_extensions cursor
        installed=1
    fi
elif command -v cursor >/dev/null 2>&1; then
    install_extensions cursor
    installed=1
elif command -v cursor.cmd >/dev/null 2>&1; then
    install_extensions cursor.cmd
    installed=1
fi

if [[ "$installed" -eq 0 ]]; then
    echo "Cursor CLI not found; cannot install extensions" >&2
    exit 1
fi

echo "==> Done."
