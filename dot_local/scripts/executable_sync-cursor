#!/usr/bin/env bash
# Sync local Cursor config into the chezmoi source directory.
# Run this after changing settings/extensions/skills in Cursor, then commit and push.
set -euo pipefail

SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"

cursor_user_dir() {
    case "$(uname -s)" in
        Darwin)
            echo "$HOME/Library/Application Support/Cursor/User"
            ;;
        Linux)
            echo "$HOME/.config/Cursor/User"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            echo "${APPDATA:-$HOME/AppData/Roaming}/Cursor/User"
            ;;
        *)
            echo "Unsupported OS for cursor_user_dir: $(uname -s)" >&2
            exit 1
            ;;
    esac
}

USER_DIR="$(cursor_user_dir)"
SETTINGS_TEMPLATE="$SOURCE_DIR/.chezmoitemplates/cursor-settings.json"
KEYBINDINGS_TEMPLATE="$SOURCE_DIR/.chezmoitemplates/cursor-keybindings.json"

if [[ ! -d "$USER_DIR" ]]; then
    echo "Cursor User directory not found: $USER_DIR" >&2
    exit 1
fi

echo "==> Syncing settings to $SETTINGS_TEMPLATE"
echo "    Note: OS-specific blocks in the template must be maintained manually."
cp "$USER_DIR/settings.json" "$SETTINGS_TEMPLATE"

echo "==> Syncing keybindings to $KEYBINDINGS_TEMPLATE"
if [[ -f "$USER_DIR/keybindings.json" ]]; then
    if grep -q '"cmd+i"' "$USER_DIR/keybindings.json" 2>/dev/null; then
        cat > "$KEYBINDINGS_TEMPLATE" <<'EOF'
// Place your key bindings in this file to override the defaults
[
    {
        "key": {{ if eq .chezmoi.os "darwin" }}"cmd+i"{{ else }}"ctrl+i"{{ end }},
        "command": "composerMode.agent"
    }
]
EOF
    else
        cp "$USER_DIR/keybindings.json" "$KEYBINDINGS_TEMPLATE"
    fi
fi

[[ -d "$USER_DIR/snippets" ]] && chezmoi re-add --recursive "$USER_DIR/snippets"

echo "==> Updating extension list"
mkdir -p "$SOURCE_DIR/dot_local/share/cursor"
if command -v cursor >/dev/null 2>&1; then
    cursor --list-extensions > "$SOURCE_DIR/dot_local/share/cursor/extensions.txt"
elif command -v cursor.cmd >/dev/null 2>&1; then
    cursor.cmd --list-extensions > "$SOURCE_DIR/dot_local/share/cursor/extensions.txt"
else
    echo "Warning: cursor CLI not found, skipping extensions.txt update" >&2
fi

echo "==> Re-adding Cursor skills"
[[ -d "$HOME/.cursor/skills" ]] && chezmoi re-add --recursive --secrets ignore "$HOME/.cursor/skills"
[[ -d "$HOME/.agents/skills" ]] && chezmoi re-add --recursive --secrets ignore "$HOME/.agents/skills"
[[ -f "$HOME/.cursor/mcp.json" ]] && chezmoi re-add "$HOME/.cursor/mcp.json"

echo "==> Done. Review changes with: chezmoi git diff"
echo "    Then commit: cd $SOURCE_DIR && git add -A && git commit -m 'sync cursor settings'"
echo "    On other machines: chezmoi update"
