#!/usr/bin/env bash
# Sync local Cursor config into the chezmoi source directory.
# Run this after changing settings/extensions/skills in Cursor, then commit and push.
set -euo pipefail

SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"

is_wsl() {
    [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null
}

windows_appdata_roaming() {
    local win_path win_user
    win_path=$(powershell.exe -NoProfile -Command '[Environment]::GetFolderPath("ApplicationData")' 2>/dev/null | tr -d '\r\n')
    if [[ -n "$win_path" ]] && command -v wslpath >/dev/null 2>&1; then
        wslpath -u "$win_path"
        return 0
    fi
    win_user=$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r\n')
    if [[ -n "$win_user" && -d "/mnt/c/Users/${win_user}/AppData/Roaming" ]]; then
        echo "/mnt/c/Users/${win_user}/AppData/Roaming"
        return 0
    fi
    return 1
}

windows_cursor_cli() {
    local win_user candidates c
    win_user=$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r\n')
    candidates=(
        "/mnt/c/Users/${win_user}/AppData/Local/Programs/cursor/resources/app/bin/cursor.cmd"
        "/mnt/c/Users/${win_user}/AppData/Local/Programs/Cursor/resources/app/bin/cursor.cmd"
        "/mnt/c/Program Files/Cursor/resources/app/bin/cursor.cmd"
    )
    for c in "${candidates[@]}"; do
        [[ -f "$c" ]] && echo "$c" && return 0
    done
    command -v cursor.cmd >/dev/null 2>&1 && echo "cursor.cmd" && return 0
    return 1
}

cursor_user_dir() {
    if is_wsl; then
        local roaming
        roaming=$(windows_appdata_roaming) || {
            echo "WSL: could not resolve Windows AppData. Is Windows Cursor installed?" >&2
            return 1
        }
        echo "${roaming}/Cursor/User"
        return 0
    fi

    case "$(uname -s)" in
        Darwin)
            echo "$HOME/Library/Application Support/Cursor/User"
            ;;
        Linux)
            echo "$HOME/.config/Cursor/User"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            echo "${APPDATA:-$HOME/AppData/Roaming}/Cursor/User"
            ;;
        *)
            echo "Unsupported OS for cursor_user_dir: $(uname -s)" >&2
            return 1
            ;;
    esac
}

USER_DIR="$(cursor_user_dir)" || exit 1
SETTINGS_TEMPLATE="$SOURCE_DIR/.chezmoitemplates/cursor-settings.json"
KEYBINDINGS_TEMPLATE="$SOURCE_DIR/.chezmoitemplates/cursor-keybindings.json"

if [[ ! -d "$USER_DIR" ]]; then
    echo "Cursor User directory not found: $USER_DIR" >&2
    exit 1
fi

echo "==> Reading Cursor settings from: $USER_DIR"

echo "==> Syncing settings to $SETTINGS_TEMPLATE"
echo "    Note: OS-specific blocks in the template must be maintained manually."
cp "$USER_DIR/settings.json" "$SETTINGS_TEMPLATE"

echo "==> Syncing keybindings to $KEYBINDINGS_TEMPLATE"
if [[ -f "$USER_DIR/keybindings.json" ]]; then
    if grep -qE '"cmd\+i"|"ctrl\+i"' "$USER_DIR/keybindings.json" 2>/dev/null; then
        cat > "$KEYBINDINGS_TEMPLATE" <<'EOF'
// Place your key bindings in this file to override the defaults
[
    {
        "key": {{ if eq .chezmoi.os "darwin" }}"cmd+i"{{ else }}"ctrl+i"{{ end }},
        "command": "composerMode.agent"
    }
]
EOF
    else
        cp "$USER_DIR/keybindings.json" "$KEYBINDINGS_TEMPLATE"
    fi
fi

[[ -d "$USER_DIR/snippets" ]] && chezmoi re-add --recursive "$USER_DIR/snippets"

echo "==> Updating extension list"
mkdir -p "$SOURCE_DIR/dot_local/share/cursor"
ext_tmp=$(mktemp)
ext_sources=0
if is_wsl; then
    if cursor_cli=$(windows_cursor_cli); then
        "$cursor_cli" --list-extensions >> "$ext_tmp" 2>/dev/null || true
        ext_sources=1
    fi
    if command -v cursor >/dev/null 2>&1; then
        cursor --list-extensions >> "$ext_tmp" 2>/dev/null || true
        ext_sources=1
    fi
elif command -v cursor >/dev/null 2>&1; then
    cursor --list-extensions >> "$ext_tmp" 2>/dev/null || true
    ext_sources=1
elif command -v cursor.cmd >/dev/null 2>&1; then
    cursor.cmd --list-extensions >> "$ext_tmp" 2>/dev/null || true
    ext_sources=1
fi
if [[ "$ext_sources" -eq 1 ]]; then
    grep -v '^[[:space:]]*$' "$ext_tmp" | sort -u > "$SOURCE_DIR/dot_local/share/cursor/extensions.txt"
else
    echo "Warning: cursor CLI not found, skipping extensions.txt update" >&2
fi
rm -f "$ext_tmp"

echo "==> Re-adding Cursor skills"
[[ -d "$HOME/.cursor/skills" ]] && chezmoi re-add --recursive --secrets ignore "$HOME/.cursor/skills"
[[ -d "$HOME/.agents/skills" ]] && chezmoi re-add --recursive --secrets ignore "$HOME/.agents/skills"
[[ -f "$HOME/.cursor/mcp.json" ]] && chezmoi re-add "$HOME/.cursor/mcp.json"

echo "==> Done. Review changes with: chezmoi git diff"
echo "    Then commit: cd $SOURCE_DIR && git add -A && git commit -m 'sync cursor settings'"
if is_wsl; then
    echo "    WSL: run 'chezmoi apply' to push settings/extensions to Windows and WSL Cursor"
else
    echo "    On other machines: chezmoi update"
fi
