#!/usr/bin/env bash

selected=${1:-$("$HOME/.local/scripts/fzf-dir")}
[[ -z "$selected" ]] && exit 0

cd -- "$selected" || exit 1
selected=$PWD

# fzf-dir reaches any depth, so a bare basename would collide (every repo has a
# src/). Label with the parent too, relative to $HOME: "Work", "repo3/src".
relative=${selected#"$HOME"/}
relative=${relative#/}
[[ "$selected" == "$HOME" ]] && relative="~"
case "$relative" in
    */*) label="$(basename "$(dirname "$relative")")/$(basename "$relative")" ;;
    *) label=$relative ;;
esac
session_name=$(printf '%s' "$label" | tr './' '__')
herdr_bin=${HERDR_BIN_PATH:-herdr}

if [[ ${HERDR_ENV:-} == 1 || -n ${HERDR_SOCKET_PATH:-} ]]; then
    workspace_id=$(
        "$herdr_bin" workspace list |
            jq -r --arg label "$label" \
                '[.result.workspaces[] | select(.label == $label)][0].workspace_id // empty'
    ) || exit 1

    if [[ -n "$workspace_id" ]]; then
        exec "$herdr_bin" workspace focus "$workspace_id" >/dev/null
    fi

    exec "$herdr_bin" workspace create --cwd "$selected" --label "$label" --focus >/dev/null
fi

exec "$herdr_bin" --session "$session_name"
