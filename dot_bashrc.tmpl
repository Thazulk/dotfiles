{{- $omarchy := stat "/usr/share/omarchy" -}}
# ~/.bashrc - Linux and WSL{{ if $omarchy }} (Omarchy){{ end }}. Aliases, editor, PATH and Go
# setup shared with zsh live in ~/.config/shell/common.sh; this file keeps only
# what is bash-specific.
{{- if $omarchy }}

# Omarchy environment (OMARCHY_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap
{{- end }}

# Sessionizer and AI toolstack scripts; also needed by agents' non-interactive shells
case ":$PATH:" in
  *":$HOME/.local/scripts:"*) ;;
  *) export PATH="$HOME/.local/scripts:$PATH" ;;
esac

# If not running interactively, don't do anything else
[[ $- != *i* ]] && return
{{- if $omarchy }}

# All the default Omarchy aliases and functions (mise, starship, zoxide, fzf).
# They load first; the dotfiles below win where both define the same name.
source "$OMARCHY_PATH/default/bash/rc"
{{- else }}

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

for fzf_bindings in /usr/share/fzf/key-bindings.bash /usr/share/doc/fzf/examples/key-bindings.bash; do
  [[ -r "$fzf_bindings" ]] && source "$fzf_bindings" && break
done
unset fzf_bindings
{{- end }}

source "$HOME/.config/shell/common.sh"

shopt -s histappend
HISTCONTROL=ignoreboth
HISTSIZE=100000
HISTFILESIZE=100000
# Share history between sessions, as zsh SHARE_HISTORY does.
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

alias reload='source ~/.bashrc'
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion bash)
  complete -o default -F __start_kubectl k
fi

# Vi mode
set -o vi
{{- if $omarchy }}
# Omarchy's inputrc was bound to the emacs keymap, so re-apply it to the vi
# keymaps to keep prefix history search on the arrows and Tab cycling.
bind -m vi-insert -f "$OMARCHY_PATH/default/bash/inputrc"
bind -m vi-command '"\e[A": history-search-backward'
bind -m vi-command '"\e[B": history-search-forward'
{{- end }}

fzf_cd_widget() {
  local selected
  selected="$("$HOME/.local/scripts/fzf-dir")" || return
  [[ -n "$selected" ]] && cd -- "$selected"
}
# ctrl+f: change directory
bind -m vi-insert -x '"\C-f": fzf_cd_widget'
# ctrl+t: tmux sessionizer (replaces fzf's file widget)
bind -m vi-insert '"\C-t": "tmux-sessionizer\n"'
# ctrl+h: herdr sessionizer
bind -m vi-insert '"\C-h": "herdr-sessionizer\n"'
# alt+f: VS Code sessionizer
bind -m vi-insert '"\ef": "vscode-sessionizer\n"'
